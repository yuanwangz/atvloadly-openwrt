#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

ATVLOADLY_ROOT=/opt/atvloadly
ATVLOADLY_BIN="$ATVLOADLY_ROOT/bin/atvloadly"
ATVLOADLY_CONFIG="$ATVLOADLY_ROOT/config.yaml"
ATVLOADLY_DATA="$ATVLOADLY_ROOT/data"
ATVLOADLY_TMP=/tmp/atvloadly

start_service() {
	[ -x "$ATVLOADLY_BIN" ] || return 1
	mkdir -p "$ATVLOADLY_DATA" "$ATVLOADLY_TMP"
	chmod 700 "$ATVLOADLY_DATA"

	procd_open_instance
	procd_set_param command "$ATVLOADLY_BIN" server --config "$ATVLOADLY_CONFIG"
	# Author: XX. Signing and temporary IPA files stay on tmpfs to avoid exhausting router overlay flash.
	procd_set_param env "HOME=$ATVLOADLY_DATA" "TMPDIR=$ATVLOADLY_TMP" "PATH=$ATVLOADLY_ROOT/bin:/usr/sbin:/usr/bin:/sbin:/bin" "ATVLOADLY_ROUTER_OVERCOMMIT=1"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}
